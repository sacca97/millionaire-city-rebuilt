{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Millionaire City",
  "version": "0.2.0",
  "identifier": "com.millionairecity.rebuilt.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/prepare.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Millionaire City, offline",
    "longDescription": "Offline revival of the Flash game Millionaire City: web client plus an embedded local game server.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../../assets": "workspace/assets",
      "../../client/dist": "workspace/apps/client/dist",
      "../assets/window-icon.ico": "workspace/apps/desktop/assets/window-icon.ico"
    }
  }
}
