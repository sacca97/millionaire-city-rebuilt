{
  "name": "@mcity/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:opt": "tsc --noEmit && MCITY_OPT=1 vite build",
    "optimize-assets": "python3 ../../tools/optimize_assets.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export-sprites": "python3 ../../tools/export_all_items.py"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
